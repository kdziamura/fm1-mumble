/* MUMBLE cast: 24x24 pixel-art busts, drawn at 3x. One letter per pixel,
 * '.' is transparent; letters index voice_palette() below. Edit freely:
 * mouths, blinks and the shout mark are overlays (see mumble_screen.inc). */

static uint16_t voice_palette(char c)
{
    switch (c) {
    case 'k': return RGB(20, 18, 30);        /* outline */
    case 'w': return RGB(255, 255, 255);     /* white */
    case 'W': return RGB(190, 195, 210);     /* pale grey */
    case 's': return RGB(250, 200, 155);     /* skin */
    case 'S': return RGB(215, 145, 105);     /* skin shade */
    case 'h': return RGB(240, 120, 140);     /* blush */
    case 'r': return RGB(220, 50, 60);       /* red */
    case 'R': return RGB(140, 25, 45);       /* dark red */
    case 'o': return RGB(250, 140, 40);      /* orange */
    case 'y': return RGB(255, 215, 60);      /* gold */
    case 'Y': return RGB(190, 130, 30);      /* dark gold */
    case 'g': return RGB(80, 200, 90);       /* green */
    case 'G': return RGB(30, 120, 70);       /* dark green */
    case 'b': return RGB(70, 130, 235);      /* blue */
    case 'B': return RGB(35, 65, 150);       /* dark blue */
    case 'c': return RGB(120, 225, 235);     /* cyan */
    case 'C': return RGB(40, 140, 170);      /* teal */
    case 'p': return RGB(160, 110, 230);     /* purple */
    case 'P': return RGB(90, 55, 150);       /* dark purple */
    case 'n': return RGB(150, 90, 45);       /* brown */
    case 'N': return RGB(85, 48, 25);        /* dark brown */
    case 'm': return RGB(140, 145, 160);     /* steel */
    case 'M': return RGB(75, 80, 98);        /* dark steel */
    default: return 0;
    }
}

