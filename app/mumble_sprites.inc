/* MUMBLE cast, line art in the OP-1 manner: 1-px white strokes and the
 * page's encoder colours on black. Portraits are 24x24 (drawn at 3x on the
 * stage); icons are 16x16 (drawn at 1x in the choir strip), each portrait
 * shrunk keeping its strongest stroke per cell. One letter per
 * pixel, '.' is empty; letters index voice_palette(). Edit freely: mouths,
 * blinks and the shout mark are overlays (see mumble_screen.inc). */

static uint16_t voice_palette(char c)
{
    switch (c) {
    case 'w': return RGB(235, 235, 235);     /* white line */
    case 'm': return RGB(110, 110, 118);     /* grey */
    case 'b': return RGB(40, 110, 220);      /* blue (encoder 1) */
    case 'g': return RGB(40, 175, 105);      /* green (encoder 2) */
    case 'o': return RGB(245, 100, 40);      /* orange (encoder 4) */
    default: return 0;
    }
}

