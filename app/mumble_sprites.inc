/* MUMBLE cast as chunky pixel avatars: black outlines, flat fills and blush
 * on a pastel tile. Portraits are 24x24 head-and-shoulders figures (drawn at
 * 3x on the stage); icons are 16x16 (1x in the choir strip), each portrait
 * shrunk by area vote. One letter per pixel, '.' is the tile; letters index
 * voice_palette(). Edit freely: mouths, blinks and the shout mark are
 * overlays (see voice_rigs in mumble_screen.inc). */

static uint16_t voice_palette(char c)
{
    switch (c) {
    case 'k': return RGB(24, 22, 30);    /* outline, black hair */
    case 'w': return RGB(250, 250, 245); /* white */
    case 'm': return RGB(120, 118, 135); /* grey */
    case 'M': return RGB(200, 200, 212); /* light grey */
    case 's': return RGB(252, 230, 208); /* light skin */
    case 'S': return RGB(226, 186, 160); /* light skin shade */
    case 'd': return RGB(150, 92, 62);   /* brown skin */
    case 'D': return RGB(108, 62, 42);   /* brown skin shade */
    case 'r': return RGB(246, 140, 170); /* blush */
    case 'p': return RGB(240, 110, 170); /* pink */
    case 'n': return RGB(62, 52, 175);   /* indigo */
    case 'y': return RGB(248, 214, 110); /* yellow */
    case 'l': return RGB(196, 232, 120); /* lime */
    case 'c': return RGB(110, 210, 220); /* cyan */
    case 'R': return RGB(215, 50, 60);   /* red */
    case 'o': return RGB(245, 120, 40);  /* orange */
    case 'g': return RGB(40, 175, 105);  /* green */
    case 'b': return RGB(40, 110, 220);  /* blue */
    default: return 0;
    }
}

/* The tile behind each character. */
static uint16_t voice_tile(unsigned cast)
{
    static const uint8_t tiles[MUMBLE_CAST][3] = {
        {140, 222, 226}, /* HERO: cyan */
        {240, 214, 150}, /* GUARD: tan */
        {244, 160, 196}, /* SISTER: pink */
        {222, 238, 182}, /* KID: lime */
        {140, 222, 226}, /* PIRATE: cyan */
        {222, 238, 182}, /* ELDER: lime */
        {240, 214, 150}, /* BOT: tan */
        {244, 160, 196}, /* GHOST: pink */
    };
    const uint8_t *t = tiles[cast % MUMBLE_CAST];
    return RGB(t[0], t[1], t[2]);
}

