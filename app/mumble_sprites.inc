/* MUMBLE cast: 16x16 line icons in the OP-1 manner, drawn at 4x on black.
 * One letter per pixel, '.' is empty; letters index voice_palette() below,
 * which keeps to the page's encoder colours. Edit freely: mouths, blinks and
 * the shout mark are overlays (see mumble_screen.inc). */

static uint16_t voice_palette(char c)
{
    switch (c) {
    case 'w': return RGB(235, 235, 235);     /* white line */
    case 'm': return RGB(110, 110, 118);     /* grey */
    case 'b': return RGB(40, 110, 220);      /* blue (encoder 1) */
    case 'g': return RGB(40, 175, 105);      /* green (encoder 2) */
    case 'o': return RGB(245, 100, 40);      /* orange (encoder 4) */
    default: return 0;
    }
}

